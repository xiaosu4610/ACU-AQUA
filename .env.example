# 环境变量示例（复制为 .env 或直接导出；机密类推荐只用 ENV 不落盘）
# 优先级：默认值 < config.toml < ENV < 命令行 flag

# 基础
AQUA_LISTEN=0.0.0.0:8787
AQUA_DB_PATH=data/aqua.db

# 站点信息（覆盖 config.toml）
AQUA_SITE_NAME=My Gateway
AQUA_SITE_DOMAIN=api.example.com
AQUA_SITE_DOCS_URL=https://example.com/#/api
AQUA_SITE_QQ_GROUP=
AQUA_SITE_QQ_GROUP_URL=

# 机密类（仅 ENV，勿写入任何文件）
# AQUA_SMTP_USER=
# AQUA_SMTP_PASS=
# AQUA_ADMIN_PASSWORD_HASH=
# AQUA_PAY_MCH_ID=
# AQUA_PAY_KEY=
