# ===== 仓库结构：Go 网关源码在仓库根目录 =====
# 本地工作区中的旧 Rust 版/文档/脚本/备份不入库；前端源码与 Go 网关源码均入库

# 旧版 Rust（本地保留，不入库）
/aqua-server/

# 前端源码入库；仅排除依赖/构建产物/本地旧仓库备份
/aqua-frontend/node_modules/
/aqua-frontend/dist/
/aqua-frontend/.git_bak/

# 根目录杂项（本地保留，不入库）
/docs/
/scripts/
/node_modules/

# 运维敏感目录（密钥/脚本/备份/文档）
/private/

# 运维构建/部署脚本目录（历史泄露清理 2026-09-15：一次性运维脚本含服务器凭据，永不入库，本地保留）
/build/

# 密钥/凭据类文件（严禁入库）
/build/keypickup/
/keypickup-*.zip
/build/wgcf/
*.priv
*.pem
gpt_email_account.txt
/build/epay-switch.sh

# 本地临时与备份
/.tmp/
/.tools/
/_del_tmp/
/legacy-git-backup/
/legacy-git-backup-2/
*.log

# 构建产物（assets/ 仓库内发行版目录除外：随 tag 发布供服务器在线更新）
aqua-linux
aqua-linux-new
aqua-gateway-go-linux
assets/*
!assets/aqua-gateway-go-linux-amd64
/bin/
/dist/
/internal/httpapi/data/

# build 目录：脚本/文本入库，二进制与压缩包不入库
/build/*.tgz
/build/*.gz
/build/*.br
/build/aqua
/build/aqua2
/build/aqua-rc*
/build/aqua-gateway-go*
/build/aqua-frontend*

# 本地环境与数据
.env
config.toml
/data/
*.db
*.db-shm
*.db-wal
aqua-gateway-go-new

accounts_MS*.txt
